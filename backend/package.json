{
    "name": "chess-analysis-backend",
    "version": "1.1.0",
    "description": "Servidor WebSocket local de análisis de ajedrez (Stockfish + SQLite)",
    "private": true,
    "type": "module",
    "main": "dist/server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "node dist/server.js",
        "test": "tsc && node --test \"dist/tests/*.test.js\""
    },
    "dependencies": {
        "better-sqlite3": "^12.9.0",
        "chess.js": "^1.4.0",
        "dotenv": "^17.4.2",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.9.1",
        "@types/ws": "^8.18.1",
        "typescript": "^6.0.3"
    }
}
